               naniar)
```

# Data loading

```{r}
# Read the downloaded file
df <- read_xlsx(here("data", "dirty_data.xlsx"))
```

# Data Exploration

```{r}
# 1. Types and first values
df |>
  glimpse()


```

```{r}
# 2. Missing values and ranges
df |>
  summary()


```

```{r}
# 3. Rows and repeated rows. If the two numbers differ, rows repeat
df |>
  count()

df |>
  distinct() |>
  count()


```

```{r}
# 4. Which rows repeat
df |>
  get_dupes()


```

```{r}
# 5. Empty rows and columns. Compare with the numbers in step 1
df |>
  remove_empty(which = c("rows", "cols")) |>
  dim()


```

```{r}
# 6. Categories spelled in more than one way. Replace column_name with a text column
df |>
  tabyl(column_name)
```

## Missing values

```{r}
# Table: missing count and percent per column, most missing first
df |>
  miss_var_summary()

# Plot: the same as bars
df |>
  gg_miss_var()

# Map of the whole table: black cells are missing
df |>
  vis_miss()

# Rows with the most missing values
df |>
  miss_case_summary()
```
